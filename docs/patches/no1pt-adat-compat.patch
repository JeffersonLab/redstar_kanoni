From c316419d94699304dcb038f7256a9105502a3fc1 Mon Sep 17 00:00:00 2001
From: Christopher Thomas <c.e.thomas@damtp.cam.ac.uk>
Date: Tue, 8 Sep 2026 16:25:45 +0100
Subject: [PATCH 1/3] Yet another operator name mangling utility function in
 irrep_util.cc

---
 lib/hadron/irrep_util.cc | 29 +++++++++++++++++++++++++++++
 lib/hadron/irrep_util.h  |  3 +++
 2 files changed, 32 insertions(+)

diff --git a/lib/hadron/irrep_util.cc b/lib/hadron/irrep_util.cc
index 05c2fdd7..81dcfd05 100644
--- a/lib/hadron/irrep_util.cc
+++ b/lib/hadron/irrep_util.cc
@@ -341,6 +341,35 @@ namespace Hadron
   }
 
 
+  //----------------------------------------------------------------------------------
+  //! Conjugate an operator name
+  std::string conjOpName(const std::string& opname)
+  {
+    std::string conj_op_name = opname;
+    std::string test_string = opname.substr(0,4);
+    if ( (test_string == "Kneg") || (test_string == "Kpos")
+	 || (test_string == "Dneg") || (test_string == "Dpos")
+	 || (test_string == "Eneg") || (test_string == "Epos") )
+    {
+      conj_op_name.insert(1,"bar");
+    }
+    else if ( (test_string == "Dsne") || (test_string == "Dspo") 
+	      || (test_string == "Esne") || (test_string == "Espo") )
+    {
+      conj_op_name.insert(2,"bar");
+    }
+    else if ( (test_string == "Kbar") || (test_string == "Dbar") || (test_string == "Ebar") )
+    {
+      conj_op_name.erase(1,3);
+    }
+    else if ( (test_string == "Dsbar") || (test_string == "Esbar") )
+    {
+      conj_op_name.erase(2,3);
+    }
+    return conj_op_name;
+  }  
+
+
   //----------------------------------------------------------------------------------
   //! Get parity from an irrep name
   int getIrrepParity(const std::string& irrep)
diff --git a/lib/hadron/irrep_util.h b/lib/hadron/irrep_util.h
index 4cb0d162..7ee84fb0 100644
--- a/lib/hadron/irrep_util.h
+++ b/lib/hadron/irrep_util.h
@@ -63,6 +63,9 @@ namespace Hadron
   //! Get continuum spin and irrep name from single-hadron operator name
   std::string getSingleHadronOpSpinIrrep(const std::string& opname);
 
+  //! Conjugate an operator name
+  std::string conjOpName(const std::string& opname);
+
   //! Irrep names (not including LG) with momentum
   /*! Turns [D4A1, Array(1,0,0)]  ->  100_A1  */
   std::string momIrrepName(const std::string& irrep, const Array<int>& mom);
-- 
