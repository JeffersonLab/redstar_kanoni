<?xml version="1.0"?>
<ColorVecHadron>
<Param> 
  <version>5</version>
  <num_vecs>10</num_vecs>
  <!-- use_derivP>false</use_derivP -->
  <use_derivP>true</use_derivP>

  <FlavorToMass>
    <elem>
      <flavor>l</flavor>
      <mass>U0.05</mass>
    </elem>
    <elem>
      <flavor>s</flavor>
      <mass>U0.1</mass>
    </elem>
    <elem>
      <flavor>c</flavor>
      <mass>U0.2</mass>
    </elem>
    <elem>
      <flavor>e</flavor>
      <mass>U0.2</mass>
    </elem>
    <elem>
      <flavor>x</flavor>
      <mass>U0.05</mass>
    </elem>
    <elem>
      <flavor>y</flavor>
      <mass>U0.05</mass>
    </elem>
  </FlavorToMass>

</Param>
<DBFiles>
  <hadron_node_xmls>
    <elem>smeared_hadron_node.xml</elem>
  </hadron_node_xmls>
  <prop_dbs><elem>prop.sdb</elem></prop_dbs>
  <baryon_dbs><elem>baryon.sdb</elem></baryon_dbs>
  <!-- meson_dbs> <elem>meson.disp.sdb</elem> </meson_dbs -->
  <meson_dbs> <elem>meson.deriv.sdb</elem> </meson_dbs>
  <glue_dbs><elem>glue.sdb</elem></glue_dbs>
  <tetra_dbs><elem>tetraquark.sdb</elem></tetra_dbs>
  <output_db>smeared_hadron_node.sdb1</output_db>
</DBFiles>	
</ColorVecHadron>
