    <ensemble>fred</ensemble>
    
    <Layout>
      <decayDir>3</decayDir>
      <lattSize>4 4 4 16</lattSize>
    </Layout>
  </Param>
    
  <NPointList>
      <elem>
        <NPoint>
          <elem>
            <t_slice>-2</t_slice>
            <Irrep>
              <creation_op>false</creation_op>
              <smearedP>true</smearedP>
              <flavor>
                <twoI>3</twoI>
                <threeY>3</threeY>
                <twoI_z>3</twoI_z>
              </flavor>
              <irmom>
                <row>1</row>
                <mom>0 0 0</mom>
              </irmom>
              <Op>
                <Operators>
                  <elem>
                    <name>DeltaSG1g1MxD1J1M_J1o2_G1u1</name>
                    <mom_class>0 0 0</mom_class>
                    </elem>
                </Operators>
                <CGs>
                </CGs>
              </Op>
            </Irrep>
          </elem>

          <elem>
            <t_slice>0</t_slice>
            <Irrep>
              <creation_op>true</creation_op>
              <smearedP>true</smearedP>
              <flavor>
                <twoI>3</twoI>
                <threeY>3</threeY>
                <twoI_z>3</twoI_z>
              </flavor>
              <irmom>
                <row>1</row>
                <mom>0 0 0</mom>
              </irmom>
              <Op>
                <Operators>
                  <elem>
                    <name>NucleonMG1g1MxD0J0S_J1o2_G1g1</name>
                    <mom_class>0 0 0</mom_class>
                  </elem>
                  <elem>
                    <name>pion_pionxD0_J0__J0_A1</name>
                    <mom_class>0 0 0</mom_class>
                  </elem>
                </Operators>
                <CGs>
                  <elem>
                    <left>1</left>
                    <right>2</right>
                    <target>
                      <slot>12</slot>
                      <F>4</F>
                      <irrep>G1u,1</irrep>
                      <mom_class>0 0 0</mom_class>
                    </target>
                  </elem>
                </CGs>
              </Op>
            </Irrep>
          </elem>
        </NPoint>
      </elem>
    </NPointList>


<DBFiles>
