<?xml version="1.0"?>


<RedstarNPt>
  <Param>
    <version>14</version>
    <diagnostic_level>0</diagnostic_level>

    <cgc_options>
      <autoIrrepCG>true</autoIrrepCG>
      <rephaseIrrepCG>true</rephaseIrrepCG>
      <enableCGTargetMomRotation>true</enableCGTargetMomRotation>
      <autoCGVersion>1</autoCGVersion>
