              <irmom>
                <row>1</row>
                <mom>0 0 0</mom>
              </irmom>
              <Op>
                <Operators>
                  <elem>
                    <name>etal_pionxD0_J0__J0_A1</name>
                    <mom_type>0 0 0</mom_type>
                  </elem>
                </Operators>
                <CGs>
                </CGs>
              </Op>
            </Irrep>
          </elem>
          <elem>
            <t_slice>-3</t_slice>
