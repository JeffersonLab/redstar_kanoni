                <threeY>0</threeY>
                <twoI_z>0</twoI_z>
              </flavor>
              <irmom>
                <row>1</row>
                <mom>0 0 0</mom>
              </irmom>
              <Op>
                <Operators>
                  <elem>
                    <name>b_b0xD0_J0__J0_A1</name>
