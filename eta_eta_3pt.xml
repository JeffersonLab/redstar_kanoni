<?xml version="1.0"?>


<RedstarNPt>
  <Param>
    <version>12</version>
    <diagnostic_level>5</diagnostic_level>
    <Nt_corr>16</Nt_corr>
    <t_origin>0</t_origin>
    <bc_spec>-1</bc_spec>
